# User-defined sources for facile.
# Place at ~/.facile.yml, ~/.config/facile/config.yml, or ~/.config/facile/sources.yml.

# Root-level tools: tool name mapped to owner/repo (with optional @branch/tag).
palette: saravenpi/palette
pres: saravenpi/pres

# Extended tool definitions when custom build options are required.
my-tool:
  summary: "A short description"
  repo: owner/my-tool
  branch: main
  bin: my-tool
  build: rust
  # versionCmd: my-tool --version
  # versionPattern: "v(\\d+\\.\\d+\\.\\d+)"

# Lists of repos to discover (one owner/repo per line or PEP 503 simple index).
lists:
  - https://example.com/facile-repos.txt
